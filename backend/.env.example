PORT=3000
# Production mandiri: arahkan ke container OSRM lokal.
OSRM_BASE_URL=http://127.0.0.1:5000
# Opsional saat masa transisi. Kosongkan setelah OSRM lokal stabil agar tidak bergantung pada demo publik.
OSRM_FALLBACK_BASE_URL=
OSRM_TIMEOUT_MS=12000
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_TIMEOUT_MS=10000
GEOCODING_USER_AGENT=AntarFixEstimator/1.0 (estimator.antarfix.id)
GEOCODING_SEARCH_RADIUS_KM=20
# Opsional untuk script buildings:sync; kosong memakai fallback server publik.
OVERPASS_BASE_URL=
DATABASE_URL=
DATABASE_POOL_MAX=10
SERVICE_AREA_CENTER_LAT=-8.4932
SERVICE_AREA_CENTER_LNG=140.4018
SERVICE_AREA_RADIUS_KM=50
MAX_DELIVERY_DISTANCE_KM=50
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
BASE_FARE=8000
INCLUDED_KM=2
PRICE_PER_KM=2500
MINIMUM_FARE=8000
FRONTEND_URL=http://localhost:5173
# Beberapa origin dipisahkan koma; FRONTEND_URL tetap didukung sebagai fallback.
FRONTEND_URLS=http://localhost:5173,http://192.168.1.6:5173
ADMIN_USERNAME=
# Buat dengan: npm run admin:hash-password -- "password-baru"
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=8
WHATSAPP_NUMBER=
